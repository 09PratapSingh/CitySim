{
  "name": "citysim-server",
  "version": "1.0.0",
  "description": "REST API and Socket.IO simulation server for CitySim",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "test": "node --experimental-strip-types --test test/**/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
